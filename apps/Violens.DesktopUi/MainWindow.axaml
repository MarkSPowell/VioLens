<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Violens.DesktopUi.ViewModels"
        xmlns:inspect="using:Violens.Extensibility.Inspection"
        xmlns:conv="using:Violens.DesktopUi.Converters"
        xmlns:controls="using:Violens.DesktopUi.Controls"
        xmlns:avc="using:Avalonia.Data.Converters"
        x:Class="Violens.DesktopUi.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="VioLens"
        Width="1100"
        Height="720"
        Icon="avares://Violens.DesktopUi/Assets/violens-icon.png"
        Background="{DynamicResource AppBackgroundBrush}">

  <!-- One DataTemplate per InspectorContent type. Avalonia looks these up in
       DataTemplates, not Resources as WPF would. -->
  <Window.DataTemplates>
    <DataTemplate DataType="inspect:TextContent">
      <TextBox Text="{Binding Text}"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Cascadia Mono,Consolas,monospace"
               VerticalAlignment="Stretch"
               BorderThickness="0" />
    </DataTemplate>

    <DataTemplate DataType="inspect:KeyValueContent">
      <!-- DataGridTextColumn.Binding doesn't support compiled bindings. -->
      <DataGrid x:CompileBindings="False"
                ItemsSource="{Binding Rows}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserSortColumns="True"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppPanelBrush}"
                RowBackground="Transparent"
                HorizontalGridLinesBrush="{DynamicResource AppBorderBrush}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </DataTemplate>

    <DataTemplate DataType="inspect:HexContent">
      <TextBox Text="{Binding Bytes, Converter={x:Static conv:HexDumpConverter.Instance}}"
               IsReadOnly="True"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Cascadia Mono,Consolas,monospace"
               VerticalAlignment="Stretch"
               BorderThickness="0" />
    </DataTemplate>

    <!-- ImageView: the summary line (format, dimensions, size), then the
         picture at its own size, scrollable. The converter returns null for
         a format Avalonia can't draw, leaving just the summary. -->
    <DataTemplate DataType="inspect:ImageContent">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Summary}"
                   Foreground="{DynamicResource AppMutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="8,4" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <Image Source="{Binding Bytes, Converter={x:Static conv:ImageBytesConverter.Instance}}"
                 Stretch="None"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="8" />
        </ScrollViewer>
      </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="inspect:ErrorContent">
      <TextBlock Text="{Binding Message}"
                 Foreground="IndianRed"
                 TextWrapping="Wrap"
                 Margin="8" />
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel Margin="16">
    <Menu DockPanel.Dock="Top"
          x:Name="MainMenuBar"
          Background="{DynamicResource AppPanelBrush}"
          Margin="0,0,0,14">
      <MenuItem Header="_File">
        <MenuItem Header="_Open SAZ…" Click="OpenSazMenuItem_Click" HotKey="Ctrl+O" />
        <MenuItem Header="_Save SAZ…" Command="{Binding SaveSazCommand}" HotKey="Ctrl+S" />
        <Separator />
        <!-- HTTP Archive, the format browsers' developer tools and support
             teams use. Bodies are written decoded (see HarWriter). -->
        <MenuItem Header="Import _HAR…" Click="ImportHarMenuItem_Click" />
        <MenuItem Header="Export HA_R…" Click="ExportHarMenuItem_Click" IsEnabled="{Binding HasSessions}" />
        <!-- Enabled once an extension offers an importer or exporter; the
             tooltip explains why they're greyed out otherwise. -->
        <Separator />
        <MenuItem Header="Import via _Extension…"
                  Command="{Binding ImportViaExtensionCommand}"
                  ToolTip.Tip="Adds sessions using a format an installed extension can read, such as a Chromium NetLog capture. If extensions offer more than one format, you'll be asked which. Disabled until an extension that imports is in the Extensions folder; see Tools -&gt; Extensions for what's loaded." />
        <MenuItem Header="Export via Extensio_n…"
                  Command="{Binding ExportViaExtensionCommand}"
                  ToolTip.Tip="Writes every captured session out in a format an installed extension provides. If extensions offer more than one format, you'll be asked which. Disabled until an extension that exports is loaded and at least one session has been captured." />
      </MenuItem>

      <!-- Removing sessions from the list (and from what Save SAZ writes).
           The Delete key does the same for the selected session while the
           session list has focus (MainWindow.axaml.cs). -->
      <MenuItem Header="_Edit">
        <MenuItem Header="Remove _Selected Session" Command="{Binding RemoveSelectedSessionCommand}" InputGesture="Delete" />
        <MenuItem Header="Remove _All Sessions" Command="{Binding RemoveAllSessionsCommand}" />
        <Separator />
        <!-- Fiddler Classic's Find Sessions: highlights every session that
             contains some text (URL, headers or decompressed bodies) and
             selects the first; F3 goes to the next. See MainWindowViewModel.Find.cs. -->
        <MenuItem Header="_Find Sessions…" Command="{Binding ShowFindCommand}" HotKey="Ctrl+F" InputGesture="Ctrl+F" />
        <MenuItem Header="Find _Next" Command="{Binding FindNextCommand}" HotKey="F3" InputGesture="F3" />
        <MenuItem Header="_QuickExec" Click="QuickExecMenuItem_Click" HotKey="Alt+Q" InputGesture="Alt+Q" />
        <Separator />
        <!-- Replay sends the selected request again, unchanged (Fiddler
             Classic's Reissue; the R key does the same in the session
             list). Edit in Composer copies it to the Composer tab to change
             first. Both send through VioLens, so capture must be running. -->
        <MenuItem Header="_Replay Selected Session" Command="{Binding ReplaySelectedSessionCommand}" InputGesture="R" />
        <MenuItem Header="Edit in _Composer" Command="{Binding EditInComposerCommand}" />
        <Separator />
        <!-- Two sessions side by side (Ctrl+click the second one first).
             See CompareWindow. -->
        <MenuItem Header="Co_mpare Sessions" Click="CompareSessionsMenuItem_Click" HotKey="Ctrl+W" InputGesture="Ctrl+W" />
      </MenuItem>

      <!-- The loaded script's RulesOption/RulesString entries, as one flat list
           ("Submenu: Option") rather than nested submenus. Greyed out when empty,
           since an empty ItemsSource menu otherwise looks broken. -->
      <MenuItem Header="_Rules"
                ItemsSource="{Binding RulesMenuEntries}"
                IsEnabled="{Binding HasRulesMenuEntries}"
                ToolTip.Tip="Populated from [RulesOption]/[RulesString] attributes in the currently-loaded FiddlerScript file (Tools -&gt; FiddlerScript to load one). Empty/disabled when no script is loaded, or the loaded script declares none -- see the FiddlerScript Compatibility Design doc's 'Phase B/C/D' section.">
        <MenuItem.ItemTemplate>
          <DataTemplate x:DataType="vm:RulesMenuEntryViewModel">
            <MenuItem Header="{Binding Header}" ToggleType="CheckBox" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
          </DataTemplate>
        </MenuItem.ItemTemplate>
      </MenuItem>

      <!-- Panel toggles. Script ToolsActions are buttons in the FiddlerScript
           panel, where they're easier to find. -->
      <MenuItem Header="_Tools" x:Name="ToolsMenu">
        <MenuItem Header="FiddlerScript" ToggleType="CheckBox" IsChecked="{Binding ShowFiddlerScriptPanel, Mode=TwoWay}" />
        <MenuItem Header="Extensions" ToggleType="CheckBox" IsChecked="{Binding ShowExtensionsPanel, Mode=TwoWay}" />
        <MenuItem Header="Legacy Extension Host" ToggleType="CheckBox" IsChecked="{Binding ShowLegacyExtensionHostPanel, Mode=TwoWay}" />
        <MenuItem Header="Break on Requests" ToggleType="CheckBox" IsChecked="{Binding BreakOnAllRequests, Mode=TwoWay}" />
        <MenuItem Header="Break on Responses" ToggleType="CheckBox" IsChecked="{Binding BreakOnAllResponses, Mode=TwoWay}" />
        <MenuItem Header="Also Break On" ToggleType="CheckBox" IsChecked="{Binding ShowAlsoBreakOnRow, Mode=TwoWay}" />
        <MenuItem Header="AutoResponder" ToggleType="CheckBox" IsChecked="{Binding AutoResponderEnabled, Mode=TwoWay}" />
        <MenuItem Header="Connections" ToggleType="CheckBox" IsChecked="{Binding ShowConnectionsRow, Mode=TwoWay}" />
        <Separator />
        <!-- Encodes and decodes text: Base64, URL, hex, JWT... (see
             TextWizardWindow). Text selected in an inspector when it opens
             becomes its input. -->
        <MenuItem Header="_TextWizard…" Click="TextWizardMenuItem_Click" HotKey="Ctrl+E" InputGesture="Ctrl+E" />
        <!-- Show or hide session-list columns (also on right-click of a
             column header). Filled in by MainWindow.axaml.cs, since script
             and extension columns come and go. -->
        <MenuItem Header="Session List _Columns" x:Name="ColumnsMenu" />
        <Separator />
        <!-- Stops capturing and removes VioLens's root certificate from this
             account's certificate stores; the Windows uninstaller does the
             same (see Program.RemoveRootCertificateArgument). -->
        <MenuItem Header="Remove _Root Certificate" Command="{Binding RemoveRootCertificateCommand}" />
      </MenuItem>

      <!-- Documentation opens the bundled User Guide. About and Copy
           Diagnostic Info are Click handlers because they need this window
           (as the dialog's owner, and for the clipboard). -->
      <MenuItem Header="_Help" x:Name="HelpMenu">
        <MenuItem Header="_Documentation" Command="{Binding OpenDocumentationCommand}" />
        <MenuItem Header="Copy Diagnostic _Info" Click="CopyDiagnosticInfoMenuItem_Click" />
        <Separator />
        <MenuItem Header="Check for _Updates" Command="{Binding CheckForUpdatesNowCommand}" />
        <MenuItem Header="Check for Updates at _Start-up"
                  ToggleType="CheckBox"
                  IsChecked="{Binding CheckForUpdatesAtStartup, Mode=TwoWay}" />
        <Separator />
        <MenuItem Header="_About VioLens" Click="AboutMenuItem_Click" />
      </MenuItem>
    </Menu>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,14">
      <TextBlock Text="VioLens"
                 FontSize="20"
                 FontWeight="Bold"
                 Foreground="{DynamicResource AppAccentBrush}"
                 VerticalAlignment="Center" />
      <TextBlock Text="Plaintext HTTPS Traffic Visibility"
                 FontSize="13"
                 Foreground="{DynamicResource AppMutedTextBrush}"
                 VerticalAlignment="Center" />
      <!-- The update notice (see MainWindowViewModel.Updates.cs). -->
      <Button Content="{Binding UpdateNotice}"
              Command="{Binding OpenUpdatePageCommand}"
              IsVisible="{Binding HasUpdate}"
              Classes="accent"
              ToolTip.Tip="Opens the release's page on GitHub, with its notes and downloads."
              VerticalAlignment="Center"
              Margin="12,0,0,0" />
    </StackPanel>

    <Border DockPanel.Dock="Top"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            Margin="0,0,0,14">
      <!-- A Grid so the filter box can take the remaining width. -->
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <TextBlock Text="Port:" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
          <RadioButton Content="Auto"
                       GroupName="PortMode"
                       IsChecked="{Binding UseAutomaticPort, Mode=TwoWay}"
                       IsEnabled="{Binding !IsRunning}"
                       VerticalAlignment="Center" />
          <RadioButton Content="Specify"
                       GroupName="PortMode"
                       IsChecked="{Binding UseSpecificPort, Mode=TwoWay}"
                       IsEnabled="{Binding !IsRunning}"
                       VerticalAlignment="Center" />
          <!-- No spinner buttons: nobody steps through port numbers. -->
          <NumericUpDown Value="{Binding PreferredPort, Mode=TwoWay}"
                          Minimum="1"
                          Maximum="65535"
                          FormatString="0"
                          ShowButtonSpinner="False"
                          IsEnabled="{Binding !IsRunning}"
                          IsVisible="{Binding !UseAutomaticPort}"
                          Width="130" />
          <Button Content="Start" Command="{Binding StartCommand}" Classes="accent" />
          <Button Content="Stop" Command="{Binding StopCommand}" />
          <!-- Fiddler Classic's "Keep: N sessions", so a long capture doesn't
               grow without limit. Oldest sessions go first. -->
          <!-- The entries say what they do ("Keep newest 1,000"), so there's
               no separate label to miss. -->
          <ComboBox ItemsSource="{Binding SessionsToKeepLabels}"
                    SelectedIndex="{Binding SessionsToKeepIndex, Mode=TwoWay}"
                    ToolTip.Tip="Once the session list holds this many sessions, the oldest are removed as new ones arrive. Choose a limit for long captures, so VioLens's memory use stays steady."
                    Margin="8,0,0,0"
                    VerticalAlignment="Center" />
        </StackPanel>

        <!-- See SessionQuery for the syntax. -->
        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Text="{Binding FilterText, Mode=TwoWay}"
                 PlaceholderText="Filter: free text, or method:GET  host:example.com  status:4xx"
                 VerticalAlignment="Center"
                 Margin="16,0,0,0" />

        <!-- Fiddler's bpu/bpafter/bpm/bps. These live outside the breakpoints
             panel because setting one is what makes that panel appear. Hiding the
             row doesn't clear them. -->
        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,10,0,0"
                    IsVisible="{Binding ShowAlsoBreakOnRow}">
          <TextBlock Text="Also break on:" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
          <TextBox Text="{Binding RequestUrlContains, Mode=TwoWay}"
                   PlaceholderText="bpu: request URL contains…"
                   VerticalAlignment="Center"
                   Width="170" />
          <TextBox Text="{Binding ResponseUrlContains, Mode=TwoWay}"
                   PlaceholderText="bpafter: response's request URL contains…"
                   VerticalAlignment="Center"
                   Width="200" />
          <TextBox Text="{Binding RequestMethodEquals, Mode=TwoWay}"
                   PlaceholderText="bpm: method"
                   VerticalAlignment="Center"
                   Width="110" />
          <NumericUpDown Value="{Binding ResponseStatusCodeEquals, Mode=TwoWay}"
                          Minimum="100"
                          Maximum="599"
                          FormatString="0"
                          VerticalAlignment="Center"
                          Width="120" />
        </StackPanel>

        <!-- Tools > Connections: the upstream proxy VioLens forwards
             through (empty = whatever the system proxy was before Start),
             and whether phones and other computers may use VioLens as
             their proxy (Fiddler Classic's "Allow remote computers to
             connect"; takes effect on the next Start). -->
        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Spacing="6"
                    Margin="0,10,0,0"
                    IsVisible="{Binding ShowConnectionsRow}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Upstream proxy:" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
            <TextBox Text="{Binding UpstreamProxySetting, Mode=TwoWay}"
                     PlaceholderText="Automatic (the system proxy)"
                     ToolTip.Tip="Where VioLens sends its own connections. Leave empty to use the proxy this computer was set to before capture started; type host:port for a specific proxy, or none to connect directly."
                     VerticalAlignment="Center"
                     Width="240" />
            <TextBlock Text="{Binding GatewayStatus}" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Proxy sign-in:" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
            <TextBox Text="{Binding ProxyUserName, Mode=TwoWay}"
                     PlaceholderText="User name (optional)"
                     ToolTip.Tip="For an upstream proxy that asks for a sign-in. Leave empty to sign in as you (Windows sign-in), which is what most company proxies use. Type DOMAIN\user or a user name to use a different account."
                     VerticalAlignment="Center"
                     Width="180" />
            <TextBox Text="{Binding ProxyPassword, Mode=TwoWay}"
                     PasswordChar="&#x2022;"
                     PlaceholderText="Password"
                     ToolTip.Tip="Only kept while VioLens is running; it's never saved."
                     VerticalAlignment="Center"
                     Width="160" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <CheckBox Content="Allow remote computers to connect"
                      IsChecked="{Binding AllowRemoteClients, Mode=TwoWay}"
                      IsEnabled="{Binding !IsRunning}"
                      ToolTip.Tip="Lets phones and other computers on your network use VioLens as their proxy, so their web traffic shows here. Anyone on the network can then use it, so turn it off when you've finished. Takes effect the next time you click Start."
                      VerticalAlignment="Center" />
            <TextBlock Text="{Binding RemoteClientsHint}" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <CheckBox Content="Use HTTP/2 with browsers"
                    IsChecked="{Binding Http2Enabled, Mode=TwoWay}"
                    ToolTip.Tip="On by default. Lets browsers talk to VioLens over HTTP/2 for HTTPS sites, as they would to the site itself. VioLens then uses HTTP/2 with the site too when it supports it, and HTTP/1.1 otherwise. Turn it off to see every request as HTTP/1.1. Applies to new connections straight away."
                    VerticalAlignment="Center" />
          <!-- Fiddler Classic's "Skip decryption for the following hosts",
               for apps that pin certificates. -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Skip decryption for:" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
            <TextBox Text="{Binding SkipDecryptionHostsText, Mode=TwoWay}"
                     PlaceholderText="*.apple.com; login.example.com"
                     ToolTip.Tip="HTTPS traffic to these hosts passes through VioLens without being decrypted, so apps that only accept their server's own certificate keep working. Each shows as a single CONNECT session. Separate hosts with semicolons; * matches any part of a name. Applies to new connections straight away."
                     VerticalAlignment="Center"
                     Width="360" />
          </StackPanel>
          <!-- Mutual TLS: the certificate VioLens sends when a server asks;
               to every server, or only the listed hosts. -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Client certificate:" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
            <ComboBox ItemsSource="{Binding ClientCertificateLabels}"
                      SelectedIndex="{Binding ClientCertificateIndex, Mode=TwoWay}"
                      ToolTip.Tip="The certificate VioLens sends to a server that asks for one (mutual TLS). The list shows your personal certificates that have a private key and can be used to sign in to servers."
                      VerticalAlignment="Center"
                      MaxWidth="420" />
            <TextBlock Text="for" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
            <TextBox Text="{Binding ClientCertificateHostsText, Mode=TwoWay}"
                     PlaceholderText="every server that asks"
                     ToolTip.Tip="Leave empty to send the certificate to every server that asks for one. To limit it, list hosts separated by semicolons; * matches any part of a name, as in *.corp.example."
                     VerticalAlignment="Center"
                     Width="260" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Paused sessions: each connection waits until Resume or Abort. Shown
         while any breakpoint is armed or anything is paused (see
         IsBreakpointsPanelVisible), and expanded by default, since a paused
         connection is waiting. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsBreakpointsPanelVisible}"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,14"
            MinHeight="48"
            MaxHeight="280">
      <Expander Header="{Binding PendingBreakpoints.Count, StringFormat='Breakpoints ({0})'}"
                IsExpanded="True">
        <Grid ColumnDefinitions="260,4,*" Margin="0,8,0,0">
          <ListBox Grid.Column="0"
                    ItemsSource="{Binding PendingBreakpoints}"
                    SelectedItem="{Binding SelectedPendingBreakpoint, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PendingBreakpointViewModel">
                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource AppBorderBrush}" />

          <DockPanel Grid.Column="2" IsEnabled="{Binding SelectedPendingBreakpoint, Converter={x:Static avc:ObjectConverters.IsNotNull}}">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="Resume" Command="{Binding SelectedPendingBreakpoint.ResumeCommand}" Classes="accent" />
              <Button Content="Abort" Command="{Binding SelectedPendingBreakpoint.AbortCommand}" />
              <TextBlock Text="{Binding SelectedPendingBreakpoint.ValidationError}"
                         Foreground="{DynamicResource AppErrorBrush}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
            <TextBox Text="{Binding SelectedPendingBreakpoint.RawText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,monospace" />
          </DockPanel>
        </Grid>
      </Expander>
    </Border>

    <!-- AutoResponder rules: an ordered list of match/action pairs, edited in
         place as in Fiddler. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding AutoResponderEnabled}"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,14"
            MinHeight="48"
            MaxHeight="280">
      <Expander Header="{Binding AutoResponderRuleRows.Count, StringFormat='AutoResponder rules ({0})'}"
                IsExpanded="True">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Add Rule" Command="{Binding AddAutoResponderRuleCommand}" Classes="accent" />
            <Button Content="Remove" Command="{Binding RemoveAutoResponderRuleCommand}" />
            <Button Content="Move Up" Command="{Binding MoveAutoResponderRuleUpCommand}" />
            <Button Content="Move Down" Command="{Binding MoveAutoResponderRuleDownCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding AutoResponderRuleRows}"
                   SelectedItem="{Binding SelectedAutoResponderRule, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AutoResponderRuleViewModel">
                <Grid ColumnDefinitions="Auto,2*,3,3*" Margin="0,2">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1"
                           Text="{Binding MatchPattern, Mode=TwoWay}"
                           PlaceholderText="Match: substring, *wildcard*, EXACT:…, regex:…, NOT:…, METHOD:verb …"
                           FontFamily="Cascadia Mono,Consolas,monospace" />
                  <TextBox Grid.Column="3"
                           Text="{Binding Action, Mode=TwoWay}"
                           PlaceholderText="Action: file path, http(s)://url, *redir:, *delay:ms, *header:N=V, *reset, *drop, *bpu, *bpafter…"
                           FontFamily="Cascadia Mono,Consolas,monospace" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Expander>
    </Border>

    <!-- FiddlerScript: load a CustomRules.js; Reload re-reads it after an
         edit. Browse is a button because a read-only TextBox swallows
         PointerPressed. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ShowFiddlerScriptPanel}"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,14"
            MaxHeight="220">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppAccentBrush}"
                   Margin="0,0,0,8"
                   Text="FiddlerScript" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding FiddlerScriptPath, Mode=TwoWay}"
                   PlaceholderText="Browse for a CustomRules.js-shaped script…"
                   IsReadOnly="True"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   VerticalAlignment="Center"
                   Width="380" />
          <Button Content="Browse…" Click="BrowseFiddlerScriptButton_Click" />
          <Button Content="Load" Command="{Binding LoadFiddlerScriptCommand}" Classes="accent" />
          <Button Content="Reload" Command="{Binding ReloadFiddlerScriptCommand}" />
        </StackPanel>

        <!-- One button per ToolsAction in the loaded script; hidden when there
             are none. -->
        <DockPanel DockPanel.Dock="Top"
                   Margin="0,8,0,0"
                   IsVisible="{Binding HasToolsMenuEntries}">
          <TextBlock DockPanel.Dock="Left"
                     Text="Script Actions:"
                     VerticalAlignment="Top"
                     Margin="0,4,8,0"
                     Foreground="{DynamicResource AppMutedTextBrush}" />
          <ItemsControl ItemsSource="{Binding ToolsMenuEntries}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActionMenuEntryViewModel">
                <Button Content="{Binding Header}" Command="{Binding InvokeCommand}" Margin="0,0,8,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <ScrollViewer>
          <TextBlock Text="{Binding FiddlerScriptStatus}"
                     Foreground="{DynamicResource AppMutedTextBrush}"
                     TextWrapping="Wrap"
                     Margin="0,8,0,0" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Compiled extensions found at startup: folders scanned, what loaded,
         and any errors. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ShowExtensionsPanel}"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,14"
            MaxHeight="220">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppAccentBrush}"
                   Margin="0,0,0,8"
                   Text="Extensions" />
        <ScrollViewer>
          <TextBlock Text="{Binding ExtensionStatus}"
                     Foreground="{DynamicResource AppMutedTextBrush}"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Mono,Consolas,monospace" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Legacy Extension Host: opt-in auto-launch and its status. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ShowLegacyExtensionHostPanel}"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Margin="0,0,0,14"
            MaxHeight="220">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppAccentBrush}"
                   Margin="0,0,0,8"
                   Text="Legacy Extension Host" />
        <CheckBox DockPanel.Dock="Top"
                   IsChecked="{Binding AutoLaunchLegacyHost, Mode=TwoWay}"
                   Margin="0,0,0,8"
                   Content="Launch Violens.LegacyExtensionHost.exe automatically on Start"
                   ToolTip.Tip="Off by default -- when on, clicking Start also tries to launch the legacy extension host from its expected LegacyHost subfolder (if it isn't already running) before wiring up the session bridge. Never a hard dependency either way: Start still works exactly as before if this is off, or if the process can't be found." />
        <ScrollViewer>
          <TextBlock Text="{Binding LegacyExtensionHostStatus}"
                     Foreground="{DynamicResource AppMutedTextBrush}"
                     TextWrapping="Wrap"
                     FontFamily="Cascadia Mono,Consolas,monospace" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Status bar. Exactly one dot shows: grey when stopped, green when
         running, and a brighter flash while sessions are arriving. Docked
         bottom; it mustn't be the DockPanel's last child. -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14,10"
            Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Ellipse Width="10"
                 Height="10"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource AppAccentBrush}"
                 IsVisible="{Binding IsCaptureFlashing}" />
        <Ellipse Width="10"
                 Height="10"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource AppSuccessBrush}"
                 IsVisible="{Binding ShowSteadyRunningIndicator}" />
        <Ellipse Width="10"
                 Height="10"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource AppMutedTextBrush}"
                 IsVisible="{Binding !IsRunning}" />
        <TextBlock Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- The Find bar (Edit > Find Sessions, Ctrl+F). Enter finds, F3 goes
         to the next match, Escape closes it and clears the highlighting. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding IsFindBarVisible}"
            Background="{DynamicResource AppPanelBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10,6"
            Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Find:" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" />
        <TextBox x:Name="FindTextBox"
                 Text="{Binding FindText, Mode=TwoWay}"
                 PlaceholderText="Text to find in URLs, headers and bodies"
                 VerticalAlignment="Center"
                 Width="280">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding FindCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CloseFindCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <ComboBox SelectedIndex="{Binding FindTargetIndex, Mode=TwoWay}" VerticalAlignment="Center">
          <ComboBoxItem Content="Requests and responses" />
          <ComboBoxItem Content="Requests only" />
          <ComboBoxItem Content="Responses only" />
        </ComboBox>
        <ComboBox SelectedIndex="{Binding FindPartsIndex, Mode=TwoWay}" VerticalAlignment="Center">
          <ComboBoxItem Content="Headers and bodies" />
          <ComboBoxItem Content="Headers only" />
          <ComboBoxItem Content="Bodies only" />
        </ComboBox>
        <CheckBox Content="Match case" IsChecked="{Binding FindMatchCase, Mode=TwoWay}" VerticalAlignment="Center" />
        <CheckBox Content="Regular expression" IsChecked="{Binding FindUseRegex, Mode=TwoWay}" VerticalAlignment="Center" />
        <Button Content="Find" Command="{Binding FindCommand}" VerticalAlignment="Center" />
        <Button Content="Next" Command="{Binding FindNextCommand}" VerticalAlignment="Center" ToolTip.Tip="F3" />
        <Button Content="Close" Command="{Binding CloseFindCommand}" VerticalAlignment="Center" ToolTip.Tip="Escape; also clears the highlighting" />
        <TextBlock Text="{Binding FindStatus}" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Grid RowDefinitions="2*,4,3*">
      <!-- DataGridTextColumn.Binding doesn't support compiled bindings. -->
      <!-- The request summary under the list, as in browsers' developer tools. -->
      <DockPanel Grid.Row="0">
      <!-- QuickExec, as in Fiddler Classic: commands such as ?text, @host,
           =404, >40k, select, allbut, cls, bpu, go (Alt+Q to get here, Up
           and Down for earlier commands). See MainWindowViewModel.QuickExec.cs. -->
      <TextBox x:Name="QuickExecBox"
               DockPanel.Dock="Bottom"
               Text="{Binding QuickExecText, Mode=TwoWay}"
               PlaceholderText="QuickExec (Alt+Q): ?text  @host  =404  >40k  select image  cls  bpu text  go  help"
               FontFamily="Cascadia Mono,Consolas,monospace"
               Margin="0,4,0,0">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding RunQuickExecCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding RequestSummary}"
                 Foreground="{DynamicResource AppMutedTextBrush}"
                 Margin="4,4,4,0" />
      <DataGrid x:Name="SessionsDataGrid"
                x:CompileBindings="False"
                ItemsSource="{Binding FilteredSessions}"
                SelectedItem="{Binding SelectedSessionRow, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserSortColumns="True"
                CanUserResizeColumns="True"
                CanUserReorderColumns="True"
                GridLinesVisibility="Horizontal"
                BorderThickness="1"
                BorderBrush="{DynamicResource AppBorderBrush}"
                Background="{DynamicResource AppPanelBrush}"
                RowBackground="Transparent"
                HorizontalGridLinesBrush="{DynamicResource AppBorderBrush}"
                LoadingRow="SessionsDataGrid_LoadingRow"
                KeyDown="SessionsDataGrid_KeyDown">
        <!-- Rows styled by their session's ui-* flags (SessionRowStyle).
             MainWindow.axaml.cs puts a class on each row as it's shown; these
             styles then take the colours from the row's own data. A selected
             row drops its custom background so the selection stays visible. -->
        <DataGrid.Styles>
          <Style Selector="DataGridRow.ui-back DataGridCell">
            <Setter Property="Background" Value="{ReflectionBinding Style.Background}" />
          </Style>
          <Style Selector="DataGridRow.ui-fore DataGridCell">
            <Setter Property="Foreground" Value="{ReflectionBinding Style.Foreground}" />
          </Style>
          <Style Selector="DataGridRow.ui-back:selected DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
          </Style>
          <Style Selector="DataGridRow.ui-bold DataGridCell">
            <Setter Property="FontWeight" Value="Bold" />
          </Style>
          <Style Selector="DataGridRow.ui-italic DataGridCell">
            <Setter Property="FontStyle" Value="Italic" />
          </Style>
          <Style Selector="DataGridRow.ui-strikeout DataGridCell TextBlock">
            <Setter Property="TextDecorations" Value="Strikethrough" />
          </Style>
          <!-- Find matches: yellow, like Fiddler Classic's Find, over any
               colour a flag set. Selection still shows. -->
          <Style Selector="DataGridRow.find-match DataGridCell">
            <Setter Property="Background" Value="#FFF2A8" />
            <Setter Property="Foreground" Value="Black" />
          </Style>
          <Style Selector="DataGridRow.find-match:selected DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
          </Style>
        </DataGrid.Styles>
        <!-- The right-click menu: Compare Sessions, Replay, Edit in
             Composer and Remove, then one entry per ContextAction the loaded
             FiddlerScript declares. Filled in by MainWindow.axaml.cs each
             time it opens (SessionsDataGrid_ContextRequested), which also
             selects the row that was right-clicked if it isn't selected
             already, so the actions apply to that row. -->
        <DataGrid.ContextMenu>
          <ContextMenu x:Name="SessionContextMenu" />
        </DataGrid.ContextMenu>
        <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />
          <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="80" />
          <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="70" />
          <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="80" />
          <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
          <!-- HTTP/1.1 or HTTP/2 with the browser, then with the server when
               that differs. (Fiddler Classic's Protocol column is the scheme,
               so this one is called Version.) -->
          <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="130" />
          <DataGridTextColumn Header="Req" Binding="{Binding RequestSize}" Width="80" />
          <DataGridTextColumn Header="Resp" Binding="{Binding ResponseSize}" Width="80" />
          <!-- PNG/JPEG/GIF/WebP responses only: bytes that don't affect how
               the image looks (see ImageBloatAnalyzer). Rows where it's a
               large share of the file are tinted. -->
          <DataGridTextColumn Header="Image Bloat" Binding="{Binding ImageBloat}" Width="170" />
          <!-- The waterfall, as in browsers' developer tools: each session's
               phases (queueing, DNS, connection, TLS, sending, waiting,
               download) on a shared time axis. Hover for the breakdown. -->
          <DataGridTemplateColumn Header="Waterfall" Width="260" MinWidth="120" SortMemberPath="Session.StartedAt">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <controls:WaterfallBar Session="{Binding Session}" Margin="4,0" VerticalAlignment="Stretch" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      </DockPanel>

      <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource AppBorderBrush}" />

      <!-- Request and Response side by side, each with its inspector tabs. -->
      <!-- Inspectors, Composer, then any tabs extensions add (Fiddler
           Classic extensions put theirs on its main tab strip; see
           ExtensionUi). MainWindow.axaml.cs adds those. The "single" style
           hides the tab strip if Inspectors is ever the only tab. -->
      <TabControl Grid.Row="2" x:Name="DetailTabs" Padding="0">
        <TabControl.Styles>
          <Style Selector="TabControl.single /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="IsVisible" Value="False" />
          </Style>
        </TabControl.Styles>
        <TabItem Header="Inspectors">
      <Grid ColumnDefinitions="*,4,*">
        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Text="Request" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,4" />
          <TabControl ItemsSource="{Binding RequestInspectors}">
            <TabControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InspectorTabViewModel">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate x:DataType="vm:InspectorTabViewModel">
                <ContentControl Content="{Binding Content}" />
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource AppBorderBrush}" />

        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Text="Response" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,0,4" />
          <TabControl ItemsSource="{Binding ResponseInspectors}">
            <TabControl.ItemTemplate>
              <DataTemplate x:DataType="vm:InspectorTabViewModel">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
              <DataTemplate x:DataType="vm:InspectorTabViewModel">
                <ContentControl Content="{Binding Content}" />
              </DataTemplate>
            </TabControl.ContentTemplate>
          </TabControl>
        </DockPanel>
      </Grid>
        </TabItem>

        <!-- Fiddler Classic's Composer: a request as raw HTTP (request line
             with an https:// URL, headers, blank line, body), sent through
             VioLens so the exchange is captured as a new session. -->
        <TabItem Header="Composer" x:Name="ComposerTab">
          <DockPanel Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,6">
              <Button Content="Execute" Command="{Binding ExecuteComposerCommand}" Classes="accent" />
              <TextBlock Text="{Binding ComposerStatus}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource AppMutedTextBrush}" />
            </StackPanel>
            <!-- Where the body comes from: typed in the request text, hex
                 (for bytes that aren't text, so they're sent exactly), or a
                 file. Edit in Composer picks hex for a body that isn't text. -->
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Body" VerticalAlignment="Center" />
                <ComboBox SelectedIndex="{Binding ComposerBodySourceIndex, Mode=TwoWay}" MinWidth="200">
                  <ComboBoxItem Content="In the request text" />
                  <ComboBoxItem Content="Hex (exact bytes)" />
                  <ComboBoxItem Content="From a file" />
                </ComboBox>
              </StackPanel>
              <TextBox Text="{Binding ComposerHexBody, Mode=TwoWay}"
                       IsVisible="{Binding IsComposerHexBody}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Height="150"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       PlaceholderText="Hex bytes, such as 89 50 4E 47 0D 0A 1A 0A. Spaces and line breaks are ignored." />
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsComposerFileBody}">
                <TextBox Grid.Column="0"
                         Text="{Binding ComposerBodyFile, Mode=TwoWay}"
                         PlaceholderText="The file to send as the body, read when you click Execute" />
                <Button Grid.Column="1" Content="Browse…" Click="BrowseComposerBodyFile_Click" Margin="8,0,0,0" />
              </Grid>
            </StackPanel>
            <TextBox Text="{Binding ComposerText, Mode=TwoWay}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     VerticalAlignment="Stretch" />
          </DockPanel>
        </TabItem>
        <!-- The selected session's phases, like the Timing tab in browsers'
             developer tools. -->
        <TabItem Header="Timing">
          <ScrollViewer Margin="0,6,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding TimingHeader}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding TimingPhases}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimingPhaseRow">
                    <Grid ColumnDefinitions="220,*,90" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                      <controls:PhaseBar Grid.Column="1"
                                         StartFraction="{Binding StartFraction}"
                                         LengthFraction="{Binding LengthFraction}"
                                         Fill="{Binding Brush}"
                                         Height="12"
                                         VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Duration}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <!-- The selected WebSocket session's messages, live while it's
             open, like the Messages view in browsers' developer tools: ↑
             sent by the client, ↓ received. The selected message is shown
             in full below (JSON indented, binary as hex). See
             MainWindowViewModel.WebSocket.cs. -->
        <TabItem Header="WebSocket">
          <DockPanel Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
              <TextBlock Text="{Binding WebSocketHeader}" TextWrapping="Wrap" />
              <CheckBox Content="Hide pings and pongs" IsChecked="{Binding HideWebSocketControlMessages, Mode=TwoWay}" />
            </StackPanel>
            <Grid RowDefinitions="*,4,*">
              <DataGrid Grid.Row="0"
                        x:CompileBindings="False"
                        ItemsSource="{Binding WebSocketMessages}"
                        SelectedItem="{Binding SelectedWebSocketMessage, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        Background="{DynamicResource AppPanelBrush}"
                        HorizontalGridLinesBrush="{DynamicResource AppBorderBrush}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="50" />
                  <DataGridTextColumn Header="" Binding="{Binding Direction}" Width="34" />
                  <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90" />
                  <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80" />
                  <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="110" />
                  <DataGridTextColumn Header="Data" Binding="{Binding Preview}" Width="*" FontFamily="Cascadia Mono,Consolas,monospace" />
                </DataGrid.Columns>
              </DataGrid>
              <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="{DynamicResource AppBorderBrush}" />
              <DockPanel Grid.Row="2" Margin="0,6,0,0">
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding WebSocketMessageNote}"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />
                <TextBox Text="{Binding WebSocketMessageText}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Cascadia Mono,Consolas,monospace"
                         PlaceholderText="Select a message to see it in full." />
              </DockPanel>
            </Grid>
          </DockPanel>
        </TabItem>
        <!-- Totals and breakdowns for the sessions the filter shows: by
             type, status and host, the slowest requests, and easy wins. -->
        <TabItem Header="Statistics" IsSelected="{Binding IsStatisticsTabSelected, Mode=TwoWay}">
          <ScrollViewer Margin="0,6,0,0">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Refresh" Command="{Binding RefreshStatisticsCommand}" />
                <TextBlock Text="{Binding StatisticsSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding StatisticsSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StatisticsSection">
                    <StackPanel Spacing="2" Margin="0,0,0,8">
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource AppAccentBrush}" />
                      <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StatisticsRow">
                            <Grid ColumnDefinitions="*,160,200" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                              <controls:PhaseBar Grid.Column="1"
                                                 LengthFraction="{Binding Fraction}"
                                                 Fill="{x:Static vm:MainWindowViewModel.StatisticsBar}"
                                                 Height="10"
                                                 Margin="8,0"
                                                 VerticalAlignment="Center" />
                              <TextBlock Grid.Column="2" Text="{Binding Detail}" VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
