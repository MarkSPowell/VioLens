<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Violens.DesktopUi.TrustConfirmationWindow"
        Title="Install VioLens's root certificate?"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="avares://Violens.DesktopUi/Assets/violens-icon.png"
        Background="{DynamicResource AppBackgroundBrush}">

  <!-- Neither macOS's security add-trusted-cert nor Linux's certutil has a
       prompt of its own, so VioLens asks here first. The explanation is set
       per platform in the code-behind. -->
  <StackPanel Margin="24" Spacing="4">
    <TextBlock Text="Install VioLens's root certificate?"
               FontSize="16"
               FontWeight="Bold"
               Foreground="{DynamicResource AppAccentBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,10" />
    <TextBlock x:Name="ExplanationText"
               FontSize="12"
               Foreground="{DynamicResource AppMutedTextBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,18" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel"
              Click="CancelButton_Click"
              MinWidth="90" />
      <Button Content="Install"
              Click="InstallButton_Click"
              Classes="accent"
              MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
