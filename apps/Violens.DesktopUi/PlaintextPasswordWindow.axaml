<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Violens.DesktopUi.PlaintextPasswordWindow"
        Title="Send your proxy password in plain text?"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="avares://Violens.DesktopUi/Assets/violens-icon.png"
        Background="{DynamicResource AppBackgroundBrush}">

  <!-- Asked once per proxy (until the password changes) when a proxy offers
       only Basic sign-in, which sends the password readably. Closing the
       window counts as Don't Send. The proxy's name is set in the
       code-behind. -->
  <StackPanel Margin="24" Spacing="4">
    <TextBlock Text="Send your proxy password in plain text?"
               FontSize="16"
               FontWeight="Bold"
               Foreground="{DynamicResource AppAccentBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,10" />
    <TextBlock x:Name="ExplanationText"
               FontSize="12"
               Foreground="{DynamicResource AppMutedTextBrush}"
               TextWrapping="Wrap"
               Margin="0,0,0,18" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Don't Send"
              Click="DontSendButton_Click"
              Classes="accent"
              MinWidth="90" />
      <Button Content="Send"
              Click="SendButton_Click"
              MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
