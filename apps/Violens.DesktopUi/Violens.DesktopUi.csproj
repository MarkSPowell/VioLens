<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Violens.DesktopUi</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe's own icon (Explorer, the taskbar before the window
         opens, Start menu shortcuts). The windows set theirs from
         Assets/violens-icon.png. -->
    <ApplicationIcon>Assets\violens.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Overridden on the command line by .github/workflows/release-windows.yml
         (-p:Version=... , stamped from the pushed git tag) for a real
         installer build. This default only ever shows up in a plain local
         dotnet build/run with no such override, and is deliberately not a
         real-looking release number: the .NET SDK's own unstated default
         is plain "1.0.0", which this project is specifically reserving for
         the actual post-MVP-approval release (see the Project Plan doc);
         a local dev build showing that would be actively misleading in the
         About dialog (Help -> About VioLens, AboutWindow.axaml.cs) this
         value ultimately feeds. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Dev-tools overlay (F12 in the running app); kept out of Release builds. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Violens.ProxyCore\Violens.ProxyCore.csproj" />
    <!-- VioLens's own app logic (Compare, TextWizard, QuickExec and so on),
         kept out of the engine package. -->
    <ProjectReference Include="..\..\src\Violens.AppCore\Violens.AppCore.csproj" />
    <ProjectReference Include="..\..\src\Violens.Extensibility\Violens.Extensibility.csproj" />
    <!-- For FiddlerScriptRunner: constructed here (the composition root,
         same as BreakpointManager/AutoResponderRules above) and handed to
         InterceptingProxyListener as Violens.ProxyCore.Scripting.IScriptRunner.
         See that interface's own remarks on why the dependency only points
         this one direction. -->
    <ProjectReference Include="..\..\src\Violens.Compatibility\Violens.Compatibility.csproj" />
    <ProjectReference Include="..\..\src\Violens.Automation\Violens.Automation.csproj" />
  </ItemGroup>

  <!-- The artwork (violens.webp for the splash screen, violens-icon.png
       for window icons, violens.ico for the .exe) lives here,
       not the repo root, so it ships inside the app the same way any other
       avares:// resource does. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- Ships docs\User Guide.md alongside the built executable so Help ->
       Documentation (MainWindowViewModel.OpenDocumentationCommand) can open
       it through the OS's own file association at runtime. None, not
       AvaloniaResource: that command needs a real path on disk it can hand
       to Process.Start with UseShellExecute=true, and an avares:// resource
       is packed into this app's own assembly, not reachable by an external
       viewer at all. Link places the copy under a Documentation folder next
       to the .exe rather than mirroring the repo's docs\ layout verbatim,
       and CopyToOutputDirectory="PreserveNewest" keeps a rebuild from
       re-copying an unchanged file on every build. -->
  <ItemGroup>
    <None Include="..\..\docs\User Guide.md" Link="Documentation\User Guide.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
